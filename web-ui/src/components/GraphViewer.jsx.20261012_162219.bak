import {useEffect, useRef, useState} from 'react'
import cytoscape from 'cytoscape'
import fcose from 'cytoscape-fcose'

cytoscape.use(fcose)

const palette = {
  Technology: '#9874ff',
  Company: '#32c8f5',
  Concept: '#39dfb1',
  Person: '#ffc36e',
  Product: '#ff78c8',
  Service: '#ff788b'
}

export default function GraphViewer({
  graph, edgeLength, nodeSize, selectedTypes, layoutName, onSelectNode
}) {
  const containerRef = useRef(null)
  const cyRef = useRef(null)
  const pulseRef = useRef(null)
  const [graphReady, setGraphReady] = useState(false)
  const [nodeCount, setNodeCount] = useState(0)

  useEffect(() => {
    if (!containerRef.current) return

    if (cyRef.current) {
      cyRef.current.destroy()
      cyRef.current = null
    }
    if (pulseRef.current) {
      clearInterval(pulseRef.current)
      pulseRef.current = null
    }

    const nodes = graph?.nodes || []
    const relationships = graph?.relationships || []
    setNodeCount(nodes.length)

    const elements = [
      ...nodes.map(node => ({
        data: {
          ...node,
          id: String(node.id),
          color: palette[node.entity_type] || '#91a4c8'
        }
      })),
      ...relationships.map((rel, index) => ({
        data: {
          id: `rel-${index}-${rel.source}-${rel.target}`,
          source: String(rel.source),
          target: String(rel.target),
          relation: rel.relation || 'RELATED_TO',
          weight: rel.weight || 1
        }
      }))
    ]

    const cy = cytoscape({
      container: containerRef.current,
      elements,
      minZoom: 0.2,
      maxZoom: 4,
      wheelSensitivity: 0.18,
      selectionType: 'single',
      style: [
        {
          selector: 'node',
          style: {
            'background-color': 'data(color)',
            'background-opacity': 0.96,
            label: 'data(name)',
            color: '#e9efff',
            'font-size': 10,
            'font-weight': 600,
            'text-wrap': 'ellipsis',
            'text-max-width': 105,
            'text-outline-color': '#080d1b',
            'text-outline-width': 3,
            width: `mapData(degree,0,10,${nodeSize * .65},${nodeSize * 1.65})`,
            height: `mapData(degree,0,10,${nodeSize * .65},${nodeSize * 1.65})`,
            'border-width': 1.5,
            'border-color': 'data(color)',
            'border-opacity': .85,
            'shadow-blur': 13,
            'shadow-color': 'data(color)',
            'shadow-opacity': .34,
            'shadow-offset-x': 0,
            'shadow-offset-y': 0,
            'overlay-opacity': 0,
            'transition-property': 'background-color border-width border-color opacity',
            'transition-duration': 180
          }
        },
        {
          selector: 'node:selected',
          style: {
            'border-color': '#ffffff',
            'border-width': 3,
            'shadow-blur': 30,
            'shadow-opacity': .85,
            'overlay-color': '#a78bfa',
            'overlay-opacity': .15,
            'z-index': 20
          }
        },
        {
          selector: 'node.hovered',
          style: {
            'border-color': '#b9f7ff',
            'border-width': 3,
            'shadow-blur': 28,
            'shadow-opacity': .9,
            'z-index': 30
          }
        },
        {
          selector: 'node.neighbor',
          style: {
            'border-color': '#8deeff',
            'border-width': 2.5,
            'shadow-blur': 21,
            'shadow-color': '#45d9ff',
            'shadow-opacity': .72,
            'z-index': 10
          }
        },
        {
          selector: 'edge',
          style: {
            width: 'mapData(weight,1,5,1.2,3.5)',
            'line-color': '#536b98',
            'line-opacity': .67,
            'target-arrow-color': '#7a91c5',
            'target-arrow-shape': 'triangle',
            'arrow-scale': .85,
            'curve-style': 'bezier',
            label: 'data(relation)',
            color: '#9aaed2',
            'font-size': 7,
            'font-weight': 600,
            'text-rotation': 'autorotate',
            'text-background-color': '#0a1021',
            'text-background-opacity': .88,
            'text-background-padding': 2,
            'text-outline-width': 0,
            'transition-property': 'line-color line-opacity width',
            'transition-duration': 240
          }
        },
        {
          selector: 'edge.connected',
          style: {
            'line-color': '#64e7ff',
            'target-arrow-color': '#9cf3ff',
            'line-opacity': 1,
            width: 2.8,
            'shadow-blur': 10,
            'shadow-color': '#25c8ff',
            'shadow-opacity': .65,
            'z-index': 8
          }
        },
        {
          selector: '.faded',
          style: { opacity: .12, 'text-opacity': .15 }
        }
      ],
      layout: {
        name: layoutName === 'fcose' ? 'fcose' : layoutName,
        animate: true,
        animationDuration: 750,
        randomize: true,
        fit: true,
        padding: 55,
        idealEdgeLength: edgeLength,
        nodeRepulsion: 8000,
        edgeElasticity: .32,
        gravity: .22
      }
    })

    cy.on('tap', 'node', event => {
      const node = event.target
      cy.elements().removeClass('neighbor connected')
      node.closedNeighborhood().nodes().not(node).addClass('neighbor')
      node.closedNeighborhood().edges().addClass('connected')
      onSelectNode(node.data())
    })

    cy.on('tap', event => {
      if (event.target === cy) {
        cy.elements().removeClass('neighbor connected')
        onSelectNode(null)
      }
    })

    cy.on('mouseover', 'node', event => {
      event.target.addClass('hovered')
    })
    cy.on('mouseout', 'node', event => {
      event.target.removeClass('hovered')
    })

    cyRef.current = cy
    setGraphReady(true)

    // Subtle pulse on graph edges; the interval is cleaned up on rebuild/unmount.
    let pulse = false
    pulseRef.current = setInterval(() => {
      if (cyRef.current !== cy || cy.destroyed()) return
      pulse = !pulse
      cy.edges(':visible').not('.connected').forEach(edge => {
        edge.style('line-opacity', pulse ? .82 : .48)
        edge.style('line-color', pulse ? '#617aa9' : '#45577e')
      })
    }, 1250)

    return () => {
      if (pulseRef.current) clearInterval(pulseRef.current)
      pulseRef.current = null
      cy.destroy()
      if (cyRef.current === cy) cyRef.current = null
    }
  }, [graph, edgeLength, nodeSize, layoutName, onSelectNode])

  useEffect(() => {
    const cy = cyRef.current
    if (!cy) return
    cy.nodes().forEach(node => {
      node.toggleClass('faded', !selectedTypes.includes(node.data('entity_type')))
    })
  }, [selectedTypes, graphReady])

  function fitGraph() {
    const cy = cyRef.current
    if (cy) cy.animate({fit: {eles: cy.elements(':visible'), padding: 55}}, {duration: 350})
  }

  function zoomIn() {
    const cy = cyRef.current
    if (cy) cy.zoom({level: Math.min(cy.zoom() * 1.25, cy.maxZoom()), renderedPosition: {
      x: cy.width() / 2, y: cy.height() / 2
    }})
  }

  function zoomOut() {
    const cy = cyRef.current
    if (cy) cy.zoom({level: Math.max(cy.zoom() / 1.25, cy.minZoom()), renderedPosition: {
      x: cy.width() / 2, y: cy.height() / 2
    }})
  }

  function resetLayout() {
    const cy = cyRef.current
    if (!cy) return
    cy.layout({
      name: layoutName === 'fcose' ? 'fcose' : layoutName,
      animate: true,
      animationDuration: 650,
      randomize: true,
      fit: true,
      padding: 55,
      idealEdgeLength: edgeLength,
      nodeRepulsion: 8000,
      edgeElasticity: .32,
      gravity: .22
    }).run()
  }

  return (
    <div className="graph-stage">
      <div className="graph-floating-tools">
        <span className="graph-live-indicator"><i /> LIVE GRAPH</span>
        <div className="graph-tool-group">
          <button type="button" title="Zoom out" aria-label="Zoom out" onClick={zoomOut}></button>
          <button type="button" title="Zoom in" aria-label="Zoom in" onClick={zoomIn}>+</button>
          <button type="button" title="Fit graph to view" aria-label="Fit graph" onClick={fitGraph}>Fit</button>
          <button type="button" title="Rearrange graph" aria-label="Reset graph layout" onClick={resetLayout}>Reflow</button>
        </div>
      </div>
      <div ref={containerRef} className="graph-canvas" />
      {nodeCount === 0 && (
        <div className="graph-empty-overlay">
          <div className="graph-empty-orb"></div>
          <strong>Your knowledge graph starts here</strong>
          <span>Research a topic or load the demo graph to explore connections.</span>
        </div>
      )}
      <div className="graph-footer">
        <span><b>{nodeCount}</b> nodes</span>
        <span className="graph-footer-dot" />
        <span><b>{graph?.relationships?.length || 0}</b> relationships</span>
        <span className="graph-footer-hint">Hover to explore  Select a node to reveal connections</span>
      </div>
    </div>
  )
}
